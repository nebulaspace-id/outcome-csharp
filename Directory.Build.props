<Project>

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- C# 12: required for collection expressions and modern pattern syntax. -->
        <LangVersion>12.0</LangVersion>

        <!-- Lockstep version for every package in this repository. -->
        <VersionPrefix>0.8.0</VersionPrefix>

        <!-- Shared NuGet package metadata -->
        <Authors>NebulaSpace</Authors>
        <Description>NebulaSpace Outcome — a result pattern library for .NET with ASP.NET Core integration.</Description>
        <PackageTags>result-pattern;outcome;aspnetcore;error-handling;ddd</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <RepositoryUrl>https://github.com/nebulaspace-id/outcome-csharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/nebulaspace-id/outcome-csharp</PackageProjectUrl>

        <!-- One shared readme + license, packed into every package -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
