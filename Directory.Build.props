<Project>

    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Allow C# 11 features (required, init, records) on older target frameworks -->
        <LangVersion>12.0</LangVersion>

        <!-- Shared NuGet package metadata -->
        <Authors>NebulaSpace</Authors>
        <Version>0.3.0</Version>
        <Description>NebulaSpace Outcome — a result pattern library for .NET with ASP.NET Core integration.</Description>
        <PackageTags>result-pattern;outcome;aspnetcore;error-handling;ddd</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

        <!-- One shared readme + license, packed into every package -->
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" />
        <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
